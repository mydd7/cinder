{
  "name": "cinder",
  "productName": "Cinder",
  "version": "3.4.3",
  "private": true,
  "author": "Cinder",
  "license": "MIT",
  "description": "Desktop usage analytics for coding tools.",
  "homepage": "https://github.com/mydd7/cinder",
  "bugs": {
    "url": "https://github.com/mydd7/cinder/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mydd7/cinder.git"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "main.js",
  "scripts": {
    "build:web": "vite build",
    "dev:web": "vite",
    "start": "vite build && electron .",
    "dev": "node tools/dev.js",
    "icons": "node tools/make-icons.js",
    "pricing": "node tools/build-pricing.js",
    "test": "node --test test/*.test.js test/*.test.mts",
    "check": "tsc --noEmit",
    "dist": "node tools/build.js dir",
    "build": "node tools/build.js",
    "verify": "npm run format:check && npm run check:unused && npm test && npm run check && npm run build:web",
    "smoke": "node tools/smoke.js",
    "smoke:large": "node tools/smoke.js --large",
    "smoke:package": "node tools/smoke.js --package",
    "smoke:native": "node tools/smoke-native.js",
    "build:win": "node tools/build.js win",
    "build:mac": "node tools/build.js mac",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagnose": "node tools/diagnose.js",
    "diagnose:limits": "node tools/diagnose-limits.js",
    "clean": "node tools/clean.js",
    "check:unused": "knip"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron/asar": "^3.4.1",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "knip": "^6.45.0",
    "prettier": "^3.9.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "app.local.cinder",
    "productName": "Cinder",
    "copyright": "Copyright (c) 2026 Cinder",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "icon/icon.png",
      "icon/icon.ico",
      "pricing-data.json",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "main/sqlite-reader.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon/icon.png",
      "category": "Development"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Cinder-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Cinder-${version}-${arch}.${ext}"
    },
    "nsis": {
      "shortcutName": "Cinder",
      "artifactName": "Cinder-Setup-${version}.${ext}"
    }
  },
  "overrides": {
    "minimatch@>=9.0.0 <11.0.1": "^11.0.1"
  }
}
