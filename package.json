{
  "name": "cinder",
  "productName": "Cinder",
  "version": "2.1.0",
  "private": true,
  "description": "Local dashboard for AI coding token usage.",
  "main": "main.js",
  "scripts": {
    "build:web": "vite build",
    "dev:web": "vite",
    "start": "vite build && electron .",
    "dev": "concurrently -k \"vite\" \"cross-env AU_DEV=1 electron .\"",
    "icons": "node tools/make-icons.js",
    "pricing": "node tools/build-pricing.js",
    "dist": "vite build && electron-builder --dir",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.6"
  },
  "build": {
    "appId": "app.local.cinder",
    "productName": "Cinder",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "main/**/*", "icon/icon.png", "icon/icon.ico", "pricing-data.json", "dist/**/*", "package.json"],
    "asarUnpack": ["main/sqlite-reader.js"],
    "win": { "target": "nsis", "icon": "icon/icon.ico" },
    "linux": { "target": "AppImage", "icon": "icon/icon.png", "category": "Development" },
    "mac": { "target": "dmg", "icon": "icon/icon.png" },
    "nsis": { "shortcutName": "Cinder" }
  }
}
