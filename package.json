{
  "name": "cinder",
  "productName": "Cinder",
  "version": "2.6.1",
  "private": true,
  "author": "Cinder",
  "license": "MIT",
  "description": "Local dashboard for AI coding token usage.",
  "homepage": "https://github.com/mydd7/cinder",
  "bugs": {
    "url": "https://github.com/mydd7/cinder/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mydd7/cinder.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "main.js",
  "scripts": {
    "build:web": "vite build",
    "dev:web": "vite",
    "start": "vite build && electron .",
    "dev": "concurrently -k \"vite\" \"cross-env CINDER_DEV=1 electron .\"",
    "icons": "node tools/make-icons.js",
    "pricing": "node tools/build-pricing.js",
    "test": "node --test ./test/core.test.js",
    "check": "tsc --noEmit",
    "dist": "vite build && electron-builder --dir",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "app.local.cinder",
    "productName": "Cinder",
    "copyright": "Copyright © 2026 Cinder",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "icon/icon.png",
      "icon/icon.ico",
      "pricing-data.json",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "main/sqlite-reader.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon/icon.png",
      "category": "Development"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Cinder-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Cinder-${version}-${arch}.${ext}"
    },
    "nsis": {
      "shortcutName": "Cinder",
      "artifactName": "Cinder-Setup-${version}.${ext}"
    }
  }
}
